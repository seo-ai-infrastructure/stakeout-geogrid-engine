DATABASE_URL="postgresql://user:pass@ep-xyz-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:pass@ep-xyz.us-east-1.aws.neon.tech/neondb?sslmode=require"
REDIS_URL="rediss://default:pass@xyz.upstash.io:6379"

WORKER_CONCURRENCY=""             # blank = number of enabled devices
PREFLIGHT_ON_BOOT="true"          # check every new phone and print the results in the logs
DEVICE_REFRESH_MINUTES="5"        # re-read the DuoPlus phone list this often and adjust concurrency

DUOPLUS_API_KEY="dp_..."
DUOPLUS_BASE_URL="https://openapi.duoplus.net"

PROXY_SELLER_BASE_LOGIN="your_base_login"
PROXY_SELLER_PASSWORD="your_ps_password"
PROXY_SELLER_HOST="us.res.proxy-seller.com"
PROXY_GEO_MATCH="state"           # state | city | none
PROXY_ROTATION="request"          # request = new IP every request | sticky = same IP for PROXY_STICKY_MINUTES
PROXY_STICKY_MINUTES="2"
PROXY_SELLER_SD_IDS_JSON='{}'     # optional state fallback, numeric subdivision ids: '{"FL":"1234"}'
UNBIND_PROXY_BEFORE_UPLOAD="false"

R2_ACCOUNT_ID="cloudflare_account_id"
R2_ACCESS_KEY_ID="r2_access_key"
R2_SECRET_ACCESS_KEY="r2_secret_key"
R2_BUCKET_NAME="geogrid-artifacts"


# Phones are discovered from DuoPlus on every boot: powered on + ADB on + active subscription
# + a saved proxy record bound to the phone. Optional filters / overrides:
DUOPLUS_GROUP_NAME="Stakeout Workers Basic"
DEVICE_PROXY_IDS_JSON='{}'        # only if the phone list doesn't report the bound proxy: {"UXsp5":"<proxyId>"}
